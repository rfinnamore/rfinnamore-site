---
// Small inline icon set (stroke icons for windows, filled brand logos for Elsewhere)
interface Props { name: string }
const { name } = Astro.props;
---
{name === 'instagram' && <svg viewBox="0 0 24 24" class="logo" aria-hidden="true"><path d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2zM17.1 5.8a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM16.4 2H7.6A5.6 5.6 0 0 0 2 7.6v8.8A5.6 5.6 0 0 0 7.6 22h8.8a5.6 5.6 0 0 0 5.6-5.6V7.6A5.6 5.6 0 0 0 16.4 2zm3.9 14.4a3.9 3.9 0 0 1-3.9 3.9H7.6a3.9 3.9 0 0 1-3.9-3.9V7.6a3.9 3.9 0 0 1 3.9-3.9h8.8a3.9 3.9 0 0 1 3.9 3.9z"/></svg>}
{name === 'linkedin' && <svg viewBox="0 0 24 24" class="logo" aria-hidden="true"><path d="M20.4 2H3.6A1.6 1.6 0 0 0 2 3.6v16.8A1.6 1.6 0 0 0 3.6 22h16.8a1.6 1.6 0 0 0 1.6-1.6V3.6A1.6 1.6 0 0 0 20.4 2zM8 19H5V9.5h3zM6.5 8.2a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5zM19 19h-3v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4V19h-3V9.5h2.9v1.3h.04a3.2 3.2 0 0 1 2.86-1.57C18.5 9.23 19 11.2 19 13.8z"/></svg>}
{name === 'spotify' && <svg viewBox="0 0 24 24" class="logo" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.6 14.4a.62.62 0 0 1-.86.2c-2.35-1.43-5.3-1.76-8.79-.96a.62.62 0 1 1-.28-1.22c3.81-.87 7.08-.5 9.72 1.12.3.18.39.57.2.86zm1.22-2.72a.78.78 0 0 1-1.07.26c-2.69-1.65-6.79-2.13-9.97-1.17a.78.78 0 0 1-.45-1.49c3.63-1.1 8.15-.57 11.24 1.33.37.22.48.7.25 1.07zm.1-2.83C14.7 8.94 9.37 8.76 6.29 9.7a.94.94 0 1 1-.54-1.8c3.53-1.07 9.42-.86 13.13 1.34a.94.94 0 0 1-.96 1.62z"/></svg>}
{name === 'email' && <svg viewBox="0 0 24 24" class="logo" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 2v.5l-8 5-8-5V6zm0 12H4V8.8l8 5 8-5z"/></svg>}
{name === 'media' && <svg viewBox="0 0 24 24" class="line" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3v3M21 12h-3"/></svg>}
{name === 'notes' && <svg viewBox="0 0 24 24" class="line" aria-hidden="true"><path d="M4 4h12l4 4v12H4z"/><path d="M8 11h8M8 15h5"/></svg>}
{name === 'writing' && <svg viewBox="0 0 24 24" class="line" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>}
{name === 'photos' && <svg viewBox="0 0 24 24" class="line" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="3"/><circle cx="12" cy="13" r="3.5"/><path d="M8 6l1.5-2h5L16 6"/></svg>}
{name === 'cv' && <svg viewBox="0 0 24 24" class="line" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>}
{name === 'quotes' && <svg viewBox="0 0 24 24" class="line" aria-hidden="true"><path d="M7 7h4v4c0 3-1.5 5-4 6M15 7h4v4c0 3-1.5 5-4 6"/></svg>}
<style>
  .logo{width:18px;height:18px;fill:currentColor}
  .line{width:19px;height:19px;stroke:var(--ink);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
</style>
