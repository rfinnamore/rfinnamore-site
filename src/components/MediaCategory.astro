---
// Shared "zoomed-in" page for one Media Journal category (music, movies, books, podcasts).
import Base from '../layouts/Base.astro';
import Stars from './Stars.astro';
import { getMedia, catFor, highlightsNote } from '../lib/util';

interface Props { type: 'album' | 'movie' | 'book' | 'podcast' }
const cat = catFor(Astro.props.type);
const items = (await getMedia()).filter((m) => m.data.type === cat.type);
---
<Base title={`${cat.title} — Media Journal`} current="media" description={`${cat.title} in Ryan's media journal.`}>
  <a class="glass back" href="/media"><span aria-hidden="true">←</span> Back to Media Journal</a>

  <section class="glass panel" style={`view-transition-name:cat-${cat.slug}`}>
    <header class="head">
      <h1>{cat.title}</h1>
      <span class="count">{items.length} logged</span>
    </header>
    {cat.highlights && <p class="note">{highlightsNote}</p>}

    {items.length === 0
      ? <p class="empty">Nothing here yet.</p>
      : (
        <div class:list={['cards', { square: cat.square }]}>
          {items.map((m) => (
            <a class="card" href={`/media/${m.id}`}>
              {m.data.cover
                ? <img class="cover" src={m.data.cover} alt={`Cover of ${m.data.title}`} loading="lazy" />
                : <div class="cover blank"><span>{m.data.title}</span></div>}
              <b>{m.data.title}</b>
              <i>{[m.data.creator, m.data.year].filter(Boolean).join(' · ')}</i>
              <Stars rating={m.data.rating} status={m.data.status} />
            </a>
          ))}
        </div>
      )}
  </section>
</Base>

<style>
  .back{display:inline-flex;align-items:center;gap:8px;margin:36px 0 18px;padding:9px 18px 9px 14px;border-radius:999px;
    font-family:"Kanit",sans-serif;font-weight:300;font-size:15px;color:var(--soft);transition:color .2s,background .2s}
  .back:hover{color:var(--ink);background:rgba(255,255,255,.14)}
  .panel{padding:28px 30px 32px}
  .head{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
  h1{font-family:"Kanit",sans-serif;font-weight:400;font-size:38px;line-height:1.1;margin:0;width:fit-content}
  .count{font-family:"Radio Canada",sans-serif;font-size:13.5px;color:var(--faint)}
  .note{display:inline-block;margin:12px 0 0;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
    font-family:"Radio Canada",sans-serif;font-size:13.5px;color:var(--soft)}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:24px 18px;margin-top:26px}
  .card{display:flex;flex-direction:column;gap:2px;transition:transform .25s}
  .card:hover{transform:translateY(-4px)}
  .cover{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:12px;border:1px solid var(--edge);display:block;margin-bottom:8px;box-shadow:0 14px 28px -14px rgba(0,0,0,.75)}
  .square .cover{aspect-ratio:1}
  .blank{display:grid;place-items:center;padding:12px;text-align:center;background:rgba(255,255,255,.08);font-family:"Kanit",sans-serif;font-weight:300;color:var(--soft)}
  .card b{font-size:15px;line-height:1.3}
  .card i{font-style:normal;font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--soft)}
  .empty{padding:24px 0 0}
  @media (max-width:640px){.panel{padding:22px 18px}.cards{grid-template-columns:repeat(2,1fr)}h1{font-size:30px}}
</style>
