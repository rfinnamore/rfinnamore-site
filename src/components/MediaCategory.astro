---
// Static page for one Media Journal category (direct visits / no-JS). Same markup as the zoomed-in view.
import Base from '../layouts/Base.astro';
import MediaPanel from './MediaPanel.astro';
import { catFor } from '../lib/util';

interface Props { type: 'album' | 'movie' | 'book' | 'podcast' }
const cat = catFor(Astro.props.type);
---
<Base title={`${cat.title} — Media Journal`} current="media" description={`${cat.title} in Ryan's media journal.`}>
  <MediaPanel type={Astro.props.type} />
</Base>
