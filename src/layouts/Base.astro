---
import '../styles/global.css';
import site from '../data/site.json';
import links from '../data/links.json';
import uses from '../data/uses.json';
import places from '../data/places.json';
import Monogram from '../components/Monogram.astro';
import Icon from '../components/Icon.astro';
import { getNotes, getWriting, getPhotos, getMedia } from '../lib/util';

interface Props { title?: string; description?: string; nav?: boolean; current?: string }
const { title, description = site.intro, nav = true, current } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;

// only show nav links for sections that have something in them
const [n, w, p, m] = await Promise.all([getNotes(), getWriting(), getPhotos(), getMedia()]);
const sections = [
  { href: '/media', key: 'media', label: 'Media', show: m.length > 0 },
  { href: '/notes', key: 'notes', label: 'Notes', show: n.length > 0 },
  { href: '/writing', key: 'writing', label: 'Writing', show: w.length > 0 },
  { href: '/photos', key: 'photos', label: 'Photos', show: p.length > 0 },
  { href: '/places', key: 'places', label: 'Places', show: places.lived.length > 0 },
  { href: '/links', key: 'links', label: 'Links', show: links.length > 0 },
  { href: '/uses', key: 'uses', label: 'Uses', show: uses.length > 0 },
  { href: '/cv', key: 'cv', label: 'CV', show: true },
].filter((l) => l.show);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#1a0a36" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/brand/rf-favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/brand/rf-favicon-180.png" />
  <meta property="og:image" content={new URL('/brand/rf-avatar-1024.png', Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@500;700&family=Kanit:wght@300;400&family=Martel:wght@300;400&family=PT+Serif:ital,wght@0,400;0,700;1,400&family=Radio+Canada:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <div class="sky" aria-hidden="true"></div>
  <div class:list={['wrap', { sub: nav }]}>
    {nav && (
      <header class="glass top">
        <a class="home" href="/" aria-label="Home"><Monogram size={46} label="Ryan Finnamore — home" /></a>
        <nav class="sections" aria-label="Sections">
          {sections.map((l) => (
            <a href={l.href} class:list={[{ on: current === l.key }]} aria-current={current === l.key ? 'page' : undefined}>
              <Icon name={l.key} /><span>{l.label}</span>
            </a>
          ))}
        </nav>
      </header>
    )}
    <main id="content"><slot /></main>
    <footer class="foot">
      <p class="foot-est"><span>© {new Date().getFullYear()} Ryan Finnamore — Est. March 2004</span><span class="dot" aria-hidden="true">·</span><span>rfinnamore.ca — Est. October 2026</span></p>
      <p class="foot-motto" tabindex="0" aria-label="ΕΝ ΟΙΔΑ ΟΤΙ ΟΥΔΕΝ ΟΙΔΑ — I know that I know nothing"><span class="gr" lang="grc" aria-hidden="true">ΕΝ ΟΙΔΑ ΟΤΙ ΟΥΔΕΝ ΟΙΔΑ</span><span class="en" lang="en" aria-hidden="true">I KNOW THAT I KNOW NOTHING</span></p>
    </footer>
  </div>
</body>
</html>

<style>
  .foot{flex-wrap:wrap;align-items:baseline;gap:6px 24px}
  .foot p{margin:0}
  .foot-est{display:flex;flex-wrap:wrap;gap:2px 10px;line-height:1.6}
  .foot-motto{display:grid;justify-items:end;letter-spacing:.16em;line-height:1.6;cursor:default;outline:none}
  .foot-motto span{grid-area:1/1;white-space:nowrap;transition:opacity .35s ease,transform .35s ease,filter .35s ease}
  .foot-motto .en{opacity:0;transform:translateY(4px);filter:blur(3px)}
  .foot-motto:hover .gr,.foot-motto:focus .gr{opacity:0;transform:translateY(-4px);filter:blur(3px)}
  .foot-motto:hover .en,.foot-motto:focus .en{opacity:1;transform:none;filter:none;color:var(--soft)}
  @media (max-width:680px){.foot{flex-direction:column;align-items:center;text-align:center}.foot-est{justify-content:center}.foot-motto{justify-items:center}}
</style>
