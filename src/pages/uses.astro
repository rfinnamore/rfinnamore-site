---
import Base from '../layouts/Base.astro';
import uses from '../data/uses.json';
---
<Base title="Uses" current="uses" description="The stuff Ryan uses every day.">
  <h1 class="page-h">Uses</h1>
  <p class="page-sub">The things I use often.</p>
  {uses.map((s) => (
    <section class="glass panel">
      <h2>{s.section}</h2>
      <ul>
        {s.items.map((i: { name: string; note?: string; url?: string }) => (
          <li>
            {i.url ? <a href={i.url} target="_blank" rel="noopener" class="name">{i.name} <span aria-hidden="true">↗</span></a> : <span class="name">{i.name}</span>}
            {i.note && <span class="note">{i.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
<style>
  .panel{padding:24px 28px 14px;margin-bottom:18px;max-width:760px}
  h2{font-family:"Kanit",sans-serif;font-weight:300;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin:0 0 6px}
  ul{list-style:none;margin:0;padding:0}
  li{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.08)}
  li:last-child{border-bottom:0}
  .name{font-size:17px}
  a.name span{font-size:13px;color:var(--faint);transition:color .2s}
  a.name:hover span{color:var(--ink)}
  .note{font-family:"Radio Canada",sans-serif;font-size:14px;color:var(--soft);text-align:right}
  @media (max-width:600px){li{flex-direction:column;gap:2px}.note{text-align:left}}
</style>
