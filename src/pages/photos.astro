---
import Base from '../layouts/Base.astro';
import { getPhotos, fmtDate } from '../lib/util';
const photos = await getPhotos();
---
<Base title="Photos" current="photos" description="Photos by Ryan. Mostly Hamilton.">
  <h1 class="page-h">Photos</h1>
  <p class="page-sub">Mostly Hamilton. Sometimes not.</p>
  <div class="masonry">
    {photos.map((p, i) => (
      <figure>
        <button type="button" data-i={i} aria-label={`Open photo${p.data.caption ? `: ${p.data.caption}` : ''}`}>
          <img src={p.data.image} alt={p.data.caption ?? ''} loading="lazy" />
        </button>
        {(p.data.caption || p.data.location) && (
          <figcaption>{p.data.caption}{p.data.location && <span> · {p.data.location}</span>}</figcaption>
        )}
      </figure>
    ))}
  </div>

  <dialog id="lb" class="glass">
    <img id="lb-img" alt="" />
    <p id="lb-cap"></p>
    <button type="button" class="x" aria-label="Close">✕</button>
  </dialog>
  <script is:inline type="application/json" id="ph-data" set:html={JSON.stringify(photos.map((p) => ({ src: p.data.image, cap: [p.data.caption, p.data.location, fmtDate(p.data.date, true)].filter(Boolean).join(' · ') })))}></script>
</Base>

<script>
  const data = JSON.parse(document.getElementById('ph-data')?.textContent || '[]');
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap')!;
  let cur = 0;
  const show = (i: number) => { cur = (i + data.length) % data.length; img.src = data[cur].src; cap.textContent = data[cur].cap; };
  document.querySelectorAll<HTMLButtonElement>('.masonry button').forEach((b) => b.addEventListener('click', () => { show(+b.dataset.i!); lb.showModal(); }));
  lb.querySelector('.x')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  document.addEventListener('keydown', (e) => { if (!lb.open) return; if (e.key === 'ArrowRight') show(cur + 1); if (e.key === 'ArrowLeft') show(cur - 1); });
</script>

<style>
  .masonry{columns:3 240px;column-gap:14px}
  figure{break-inside:avoid;margin:0 0 14px}
  figure button{all:unset;cursor:zoom-in;display:block;width:100%}
  figure img{width:100%;display:block;border-radius:16px;border:1px solid var(--edge);box-shadow:0 14px 30px -16px rgba(0,0,0,.7);transition:transform .25s}
  figure button:hover img{transform:scale(1.015)}
  figcaption{font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--soft);margin:7px 4px 0}
  figcaption span{color:var(--faint)}
  dialog{padding:14px;max-width:min(92vw,1100px);color:var(--ink);border-radius:22px}
  dialog::backdrop{background:rgba(10,4,25,.6);backdrop-filter:blur(6px)}
  dialog img{max-width:100%;max-height:78vh;display:block;border-radius:14px;margin:0 auto}
  dialog p{font-family:"Radio Canada",sans-serif;font-size:14px;color:var(--soft);margin:10px 4px 2px}
  .x{all:unset;cursor:pointer;position:absolute;top:20px;right:22px;width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:rgba(20,8,40,.55);border:1px solid var(--edge)}
</style>
