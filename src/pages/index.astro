---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import Stars from '../components/Stars.astro';
import site from '../data/site.json';
import { getCollection, getEntry } from 'astro:content';
import { getNotes, getWriting, getPhotos, getMedia, fmtDate, plural, shelfLabel } from '../lib/util';
import { getLived, getVisited } from '../lib/places';
import linksData from '../data/links.json';
import uses from '../data/uses.json';
const lived = getLived();
const visited = getVisited();
const linkList = [...linksData].sort((a, b) => b.date.localeCompare(a.date));

const [notes, writing, photos, media] = await Promise.all([getNotes(), getWriting(), getPhotos(), getMedia()]);
const quotes = (await getCollection('quotes')).map((q) => q.data);
const cv = await getEntry('pages', 'cv');
const cvReady = !!cv && cv.data.ready && (cv.body ?? '').trim().length > 0;

// latest of each media type for the shelves
const shelves = (['album', 'movie', 'book', 'podcast'] as const)
  .map((t) => ({ type: t, item: media.find((m) => m.data.type === t) }))
  .filter((s) => s.item);

const noteText = (body = '') => body.replace(/[#*_>`\[\]]/g, '').replace(/\(([^)]*)\)/g, '').trim();
const elsewhere = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'spotify', label: 'Spotify' },
  { key: 'email', label: 'Email' },
].filter((l) => (site.links as Record<string, string>)[l.key]);
---
<Base nav={false}>
  <section class="glass intro">
    <div class="mark"><Monogram size="100%" label="RF monogram" /></div>
    <div>
      <h1>{site.headline}</h1>
      <p>{site.intro} <a href="/about">More about me</a> &amp; <a href={site.wtfPost}>wtf is this website</a>.</p>
    </div>
  </section>

  <nav class="elsewhere" aria-label="Elsewhere">
    {elsewhere.map((l) => (
      <a class="glass pill" href={(site.links as Record<string, string>)[l.key]} rel="me noopener" target={l.key === 'email' ? undefined : '_blank'}>
        <Icon name={l.key} />{l.label}
      </a>
    ))}
  </nav>

  <p class="label">The garden</p>
  <div class="grid">

    {media.length > 0 && (
      <a class="glass win wide" href="/media">
        <div class="win-head"><div class="icon"><Icon name="media" /></div><h3>Media Journal</h3><span class="count">{media.length} logged</span></div>
        <p class="desc">Everything I listen to, watch, and read, rated and reviewed. My own Letterboxd for everything.</p>
        <div class="shelves">
          {shelves.map(({ type, item }) => (
            <div class="shelf">
              <h4>{shelfLabel[type]}</h4>
              <div class="item">
                {item!.data.cover && <img class:list={[type === 'album' || type === 'podcast' ? 'sq' : 'tall']} src={item!.data.cover} alt="" loading="lazy" />}
                <div>
                  <b>{item!.data.title}</b>
                  <i>{[item!.data.creator, item!.data.year].filter(Boolean).join(', ')}</i>
                  <Stars rating={item!.data.rating} status={item!.data.status} />
                </div>
              </div>
            </div>
          ))}
        </div>
        <span class="open">Open journal →</span>
      </a>
    )}

    {notes.length > 0 && (
      <a class="glass win" href="/notes">
        <div class="win-head"><div class="icon"><Icon name="notes" /></div><h3>Notes</h3><span class="count">{plural(notes.length, 'note')}</span></div>
        <p class="desc">Short thoughts, half-ideas, and stuff I don't want to forget.</p>
        <ul class="peek">
          {notes.slice(0, 2).map((n) => <li><span class="clamp">{noteText(n.body)}</span><time>{fmtDate(n.data.date)}</time></li>)}
        </ul>
        <span class="open">Open notes →</span>
      </a>
    )}

    {writing.length > 0 && (
      <a class="glass win" href="/writing">
        <div class="win-head"><div class="icon"><Icon name="writing" /></div><h3>Writing</h3><span class="count">{plural(writing.length, 'post')}</span></div>
        <p class="desc">Longer pieces on politics, Hamilton, and whatever I'm stuck on.</p>
        <ul class="peek">
          {writing.slice(0, 2).map((p) => <li><span>{p.data.title}</span><time>{fmtDate(p.data.date)}</time></li>)}
        </ul>
        <span class="open">Read →</span>
      </a>
    )}

    {photos.length > 0 && (
      <a class="glass win wide" href="/photos">
        <div class="win-head"><div class="icon"><Icon name="photos" /></div><h3>Photos</h3><span class="count">{plural(photos.length, 'photo')}</span></div>
        <p class="desc">Mostly Hamilton. Sometimes not.</p>
        <div class="thumbs">
          {photos.slice(0, 4).map((p) => <img src={p.data.image} alt={p.data.caption ?? ''} loading="lazy" />)}
        </div>
        <span class="open">View gallery →</span>
      </a>
    )}

    {lived.months.length > 0 && (
      <a class="glass win wide" href="/places">
        <div class="win-head"><div class="icon"><Icon name="places" /></div><h3>Places</h3><span class="count">{visited.all.length} places · {visited.countries.length} {visited.countries.length === 1 ? 'country' : 'countries'}</span></div>
        <p class="desc">Where I've lived, where I've been, and how I got there. Each square is a month.</p>
        <div class="mini-months" aria-hidden="true">
          {lived.months.map((mo) => <span style={mo.colour ? `--c:${mo.colour}` : undefined}></span>)}
        </div>
        <div class="mini-key">{lived.totals.map((t) => <span><i style={`--c:${t.colour}`}></i>{t.city}</span>)}</div>
        <span class="open">Open map →</span>
      </a>
    )}

    {linkList.length > 0 && (
      <a class="glass win" href="/links">
        <div class="win-head"><div class="icon"><Icon name="links" /></div><h3>Links</h3><span class="count">{plural(linkList.length, 'link')}</span></div>
        <p class="desc">Interesting things I found around the web.</p>
        <ul class="peek">
          {linkList.slice(0, 2).map((l) => <li><span class="clamp">{l.title}</span><time>{fmtDate(new Date(l.date + 'T00:00:00Z'))}</time></li>)}
        </ul>
        <span class="open">All links →</span>
      </a>
    )}

    {uses.length > 0 && (
      <a class="glass win" href="/uses">
        <div class="win-head"><div class="icon"><Icon name="uses" /></div><h3>Uses</h3></div>
        <p class="desc">The stuff I use every day: {uses.map((s) => s.section.toLowerCase()).join(', ')}.</p>
        <div class="use-tags">{uses.flatMap((s) => s.items).slice(0, 5).map((i) => <span class="chip">{i.name}</span>)}</div>
        <span class="open">See the list →</span>
      </a>
    )}

    <a class="glass win" href="/cv">
      <div class="win-head"><div class="icon"><Icon name="cv" /></div><h3>CV</h3>{!cvReady && <span class="chip soon">soon</span>}</div>
      <p class="desc">School, work, and the things I've been part of.</p>
      <span class="open">View CV →</span>
    </a>

    {quotes.length > 0 && (
      <div class="glass win quote-win">
        <div class="win-head"><div class="icon"><Icon name="quotes" /></div><h3>Quotes</h3></div>
        <blockquote id="q"><p id="q-text">“{quotes[0].text}”</p><cite id="q-by">{quotes[0].by && `— ${quotes[0].by}`}</cite></blockquote>
        <button class="open" id="q-next" type="button">Another one ↻</button>
        <script is:inline type="application/json" id="q-data" set:html={JSON.stringify(quotes)}></script>
      </div>
    )}
  </div>
</Base>

<script>
  const data = JSON.parse(document.getElementById('q-data')?.textContent || '[]');
  const t = document.getElementById('q-text'), b = document.getElementById('q-by');
  let i = Math.floor(Math.random() * data.length);
  const show = () => { if (!data.length || !t || !b) return; t.textContent = `“${data[i].text}”`; b.textContent = data[i].by ? `— ${data[i].by}` : ''; };
  show();
  document.getElementById('q-next')?.addEventListener('click', () => { i = (i + 1 + Math.floor(Math.random() * (data.length - 1))) % data.length; show(); });
</script>

<style>
  .intro{display:flex;gap:28px;align-items:center;padding:32px}
  .mark{width:128px;height:128px;flex:none;color:var(--ink);filter:drop-shadow(0 6px 18px rgba(10,2,30,.45)) drop-shadow(0 0 1px rgba(255,255,255,.4))}
  .mark :global(svg){display:block;width:100%;height:100%}
  h1{font-family:"Advent Pro",sans-serif;font-weight:700;font-size:56px;line-height:1;margin:0 0 12px;letter-spacing:-.01em}
  .intro p{font-family:"Radio Canada",sans-serif;font-size:16.5px;line-height:1.7;margin:0;color:var(--soft)}
  .intro p a{color:var(--ink);border-bottom:1px solid rgba(255,255,255,.35);transition:border-color .2s}
  .intro p a:hover{border-color:var(--ink)}

  .elsewhere{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0 40px}
  .pill{display:inline-flex;align-items:center;gap:9px;padding:9px 16px 9px 12px;border-radius:999px;font-family:"Radio Canada",sans-serif;font-size:14px;color:var(--soft);transition:.2s}
  .pill:hover{color:var(--ink);background:rgba(255,255,255,.16);transform:translateY(-1px)}

  .label{font-family:"Kanit",sans-serif;font-weight:300;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin:0 0 14px 6px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .win{display:flex;flex-direction:column;padding:22px 24px 20px;transition:transform .25s,box-shadow .25s}
  a.win:hover{transform:translateY(-3px);box-shadow:inset 0 1px 0 rgba(255,255,255,.45),0 28px 60px -22px rgba(8,2,30,.75)}
  .win.wide{grid-column:span 2}
  .win-head{display:flex;align-items:center;gap:12px;margin-bottom:8px}
  .icon{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:rgba(255,255,255,.12);border:1px solid var(--edge)}
  h3{font-family:"Kanit",sans-serif;font-weight:400;font-size:21px;margin:0;letter-spacing:.01em}
  .count{margin-left:auto;font-family:"Radio Canada",sans-serif;font-size:12.5px;color:var(--faint)}
  .soon{margin-left:auto}
  .desc{margin:0 0 16px;color:var(--soft);font-size:15.5px}

  .peek{list-style:none;margin:0 0 18px;padding:0;border-top:1px solid rgba(255,255,255,.1)}
  .peek li{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:15px}
  .peek time{padding-top:2px}
  .clamp{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

  .thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:18px}
  .thumbs img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;border:1px solid var(--edge);display:block}

  .shelves{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;margin-bottom:18px}
  .shelf h4{font-family:"Kanit",sans-serif;font-weight:300;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:0 0 10px}
  .item{display:flex;gap:12px;align-items:center}
  .item img{width:58px;border-radius:8px;border:1px solid var(--edge);object-fit:cover;flex:none;box-shadow:0 8px 18px -8px rgba(0,0,0,.6)}
  .item img.sq{height:58px}.item img.tall{height:84px}
  .item b{display:block;font-size:15px;line-height:1.3}
  .item i{display:block;font-style:normal;font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--soft)}

  blockquote{margin:4px 0 18px;padding-top:12px;border-top:1px solid rgba(255,255,255,.1)}
  blockquote p{margin:0;font-style:italic;color:var(--soft);font-size:16px}
  blockquote cite{display:block;margin-top:6px;font-style:normal;font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--faint)}

  .mini-months{display:grid;grid-template-columns:repeat(auto-fill,minmax(7px,1fr));gap:2px;margin-bottom:12px}
  .mini-months span{aspect-ratio:1;border-radius:2px;background:var(--c,rgba(255,255,255,.08));opacity:.9}
  .mini-key{display:flex;flex-wrap:wrap;gap:6px 16px;margin-bottom:18px;font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--soft)}
  .mini-key span{display:inline-flex;align-items:center;gap:7px}
  .mini-key i{width:10px;height:10px;border-radius:3px;background:var(--c)}
  .use-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px}

  .open{margin-top:auto;font-family:"Kanit",sans-serif;font-weight:300;font-size:14.5px;color:var(--soft);display:inline-flex;gap:6px;align-items:center}
  button.open{all:unset;cursor:pointer;margin-top:auto;font-family:"Kanit",sans-serif;font-weight:300;font-size:14.5px;color:var(--soft)}
  button.open:hover,.win:hover .open{color:var(--ink)}

  @media (max-width:680px){
    .intro{flex-direction:column;align-items:flex-start;padding:24px}
    .mark{width:96px;height:96px}
    h1{font-size:44px}
    .grid{grid-template-columns:1fr}.win.wide{grid-column:auto}
    .thumbs{grid-template-columns:repeat(2,1fr)}
    .shelves{grid-template-columns:1fr}
  }
</style>
