---
import Base from '../../layouts/Base.astro';
import Stars from '../../components/Stars.astro';
import { getMedia, mediaCats, highlightsNote } from '../../lib/util';

const media = await getMedia();
const windows = mediaCats.map((c) => {
  const items = media.filter((m) => m.data.type === c.type);
  return { ...c, items, latest: items.slice(0, 3) };
}).filter((w) => w.items.length > 0);
---
<Base title="Media Journal" current="media" description="Everything Ryan listens to, watches, and reads.">
  <h1 class="page-h">Media Journal</h1>
  <p class="page-sub">Everything I listen to, watch, and read. Ratings are vibes, not science.</p>

  <div class="windows">
    {windows.map((w) => (
      <a class="glass win" href={`/media/${w.slug}`} style={`view-transition-name:cat-${w.slug}`}>
        <div class="win-head">
          <h2 style={`view-transition-name:cat-${w.slug}-title`}>{w.title}</h2>
          <span class="count">{w.items.length} logged</span>
        </div>
        {w.highlights && <p class="note">{highlightsNote}</p>}
        <ul class:list={['latest', { square: w.square }]}>
          {w.latest.map((m) => (
            <li>
              {m.data.cover
                ? <img src={m.data.cover} alt="" loading="lazy" />
                : <div class="blank">{m.data.title}</div>}
              <b>{m.data.title}</b>
              <i>{m.data.creator}</i>
              <Stars rating={m.data.rating} status={m.data.status} />
            </li>
          ))}
        </ul>
        <span class="open">See all {w.title.toLowerCase()} →</span>
      </a>
    ))}
  </div>
</Base>

<style>
  .windows{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .win{display:flex;flex-direction:column;padding:22px 24px 20px;transition:transform .25s,box-shadow .25s}
  .win:hover{transform:translateY(-3px);box-shadow:inset 0 1px 0 rgba(255,255,255,.45),0 28px 60px -22px rgba(8,2,30,.75)}
  .win-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
  h2{font-family:"Kanit",sans-serif;font-weight:400;font-size:24px;margin:0;width:fit-content}
  .count{font-family:"Radio Canada",sans-serif;font-size:12.5px;color:var(--faint)}
  .note{margin:8px 0 0;font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--faint)}
  .latest{list-style:none;margin:16px 0 18px;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .latest li{display:flex;flex-direction:column;gap:1px;min-width:0}
  .latest img,.blank{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:10px;border:1px solid var(--edge);display:block;margin-bottom:7px;box-shadow:0 10px 22px -12px rgba(0,0,0,.7)}
  .square img,.square .blank{aspect-ratio:1}
  .blank{display:grid;place-items:center;padding:8px;text-align:center;background:rgba(255,255,255,.08);font-family:"Kanit",sans-serif;font-weight:300;font-size:13px;color:var(--soft)}
  .latest b{font-size:14px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .latest i{font-style:normal;font-family:"Radio Canada",sans-serif;font-size:12.5px;color:var(--soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .latest :global(.stars){font-size:12px}
  .open{margin-top:auto;font-family:"Kanit",sans-serif;font-weight:300;font-size:14.5px;color:var(--soft)}
  .win:hover .open{color:var(--ink)}
  @media (max-width:680px){.windows{grid-template-columns:1fr}}
</style>
