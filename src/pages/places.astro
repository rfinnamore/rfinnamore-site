---
import Base from '../layouts/Base.astro';
import { getLived, getVisited, flagUrl } from '../lib/places';

const { months, totals } = getLived();
const { all, countries } = getVisited();
const fmtYears = (y: number) => (y >= 1 ? `${y.toFixed(y < 10 ? 2 : 1).replace(/\.?0+$/, '')} years` : `${Math.round(y * 12)} months`);
const mapData = {
  points: all.map((p) => ({ city: p.city, country: p.country, region: p.region, lat: p.lat, lng: p.lng, lived: p.lived })),
};
---
<Base title="Places" current="places" description="Where Ryan has lived and been.">
  <h1 class="page-h">Places</h1>
  <p class="page-sub">Where I've lived and where I've been. In the grid, each square is a month of my life and each colour is a city. (Idea borrowed from <a href="https://singh.work/fromness/" class="u">Shivani's chart of fromness</a>.)</p>

  <section class="glass panel">
    <h2>Places I've lived</h2>
    <div class="months" role="img" aria-label={`A grid of ${months.length} months, coloured by city`}>
      {months.map((m) => <span style={m.colour ? `--c:${m.colour}` : undefined} title={`${m.label}${m.city ? ` · ${m.city}` : ''}`}></span>)}
    </div>
    <h3>Total time</h3>
    <ul class="totals">
      {totals.map((t) => <li><i style={`--c:${t.colour}`}></i><span>{t.city}</span><time>{fmtYears(t.years)}</time></li>)}
    </ul>
  </section>

  <section class="glass panel">
    <div class="row">
      <h2>Visited places</h2>
      <span class="meta">{all.length} places in {countries.length} {countries.length === 1 ? 'country' : 'countries'}</span>
    </div>
    <div class="chips" role="group" aria-label="Zoom map">
      <button class="on" data-c="all">All</button>
      {countries.map((c) => <button data-c={c.code}>{c.name}</button>)}
    </div>
    <div id="map" class="map"></div>
    <div class="legend"><span><i class="dot lived"></i>lived in</span><span><i class="dot"></i>visited</span></div>

    <div class="countries">
      {countries.map((c) => (
        <div class="country">
          <h4><img src={flagUrl(c.code)} alt="" width="22" height="16" loading="lazy" />{c.name}<span>{c.places.length}</span></h4>
          {c.regions.map((r) => (
            <details class="region" data-c={c.code} data-r={r.name}>
              <summary><span>{r.name}</span><em>{r.places.length}</em></summary>
              <ul>{r.places.map((p) => <li class:list={[{ lived: p.lived }]}>{p.city}</li>)}</ul>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>

  <script is:inline type="application/json" id="map-data" set:html={JSON.stringify(mapData)}></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (function () {
      const d = JSON.parse(document.getElementById('map-data').textContent);
      const L = window.L; if (!L || !d.points.length) return;
      const map = L.map('map', { scrollWheelZoom: false, attributionControl: true, zoomControl: true });
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri', maxZoom: 16,
      }).addTo(map);
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', { maxZoom: 16, opacity: .6 }).addTo(map);
      const markers = d.points.map((p) => L.circleMarker([p.lat, p.lng], {
        radius: p.lived ? 7 : 5, color: '#fff', weight: 1.5, fillColor: p.lived ? '#b79cff' : '#7fb2ff', fillOpacity: .95,
      }).bindTooltip(p.city).addTo(map));
      const fit = (pts) => map.fitBounds(L.latLngBounds(pts.map((p) => [p.lat, p.lng])).pad(0.35), { maxZoom: 9 });
      fit(d.points);
      document.querySelectorAll('details.region').forEach((el) => el.addEventListener('toggle', () => {
        if (!el.open) return;
        const pts = d.points.filter((p) => p.country.toLowerCase() === el.dataset.c && p.region === el.dataset.r);
        if (pts.length) fit(pts);
      }));
      document.querySelectorAll('.chips button').forEach((b) => b.addEventListener('click', () => {
        document.querySelectorAll('.chips button').forEach((x) => x.classList.toggle('on', x === b));
        fit(b.dataset.c === 'all' ? d.points : d.points.filter((p) => p.country.toLowerCase() === b.dataset.c));
      }));
    })();
  </script>
</Base>

<style>
  .u{border-bottom:1px solid rgba(255,255,255,.4)}
  .panel{padding:26px 28px;margin-bottom:20px}
  h2{font-family:"Kanit",sans-serif;font-weight:400;font-size:22px;margin:0 0 16px}
  h3{font-family:"Kanit",sans-serif;font-weight:300;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:24px 0 10px}
  .row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
  .meta{font-family:"Radio Canada",sans-serif;font-size:13.5px;color:var(--faint)}

  .months{display:grid;grid-template-columns:repeat(auto-fill,minmax(11px,1fr));gap:3px}
  .months span{aspect-ratio:1;border-radius:3px;background:var(--c,rgba(255,255,255,.08));opacity:.92;transition:transform .15s}
  .months span:hover{transform:scale(1.6);opacity:1;position:relative;z-index:1}

  .totals{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px}
  .totals li{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);font-size:15px}
  .totals li span{flex:1}
  .totals i{width:12px;height:12px;border-radius:3px;background:var(--c);flex:none}

  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
  .chips button{all:unset;cursor:pointer;font-family:"Kanit",sans-serif;font-weight:300;font-size:13.5px;color:var(--soft);padding:5px 14px;border-radius:999px;border:1px solid var(--edge);transition:.2s}
  .chips button:hover{color:var(--ink)}
  .chips button.on{background:rgba(255,255,255,.18);color:var(--ink)}
  .map{height:380px;border-radius:18px;border:1px solid var(--edge);overflow:hidden;background:#1a1530;isolation:isolate;position:relative;z-index:0}
  .map :global(.leaflet-bar a){background:rgba(30,16,60,.85);color:#f4effa;border-color:rgba(255,255,255,.15)}
  .map :global(.leaflet-bar){border:1px solid rgba(255,255,255,.2);box-shadow:none;border-radius:10px;overflow:hidden}
  .map :global(.leaflet-tile-pane){filter:sepia(.5) hue-rotate(215deg) saturate(1.5) brightness(.9)}
  .map :global(.leaflet-tooltip){font-family:"Radio Canada",sans-serif;background:rgba(30,16,60,.9);color:#f4effa;border:1px solid rgba(255,255,255,.2);box-shadow:none}
  .map :global(.leaflet-control-attribution){background:rgba(20,10,40,.6);color:rgba(255,255,255,.55)}
  .map :global(.leaflet-control-attribution a){color:rgba(255,255,255,.75)}
  .legend{display:flex;gap:18px;margin:10px 4px 0;font-family:"Radio Canada",sans-serif;font-size:13px;color:var(--faint)}
  .legend span{display:inline-flex;align-items:center;gap:7px}
  .dot{width:10px;height:10px;border-radius:50%;background:#7fb2ff;border:1.5px solid #fff}
  .dot.lived{background:#b79cff}

  .countries{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin-top:22px;align-items:start}
  .country{padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
  .country h4{display:flex;align-items:center;gap:9px;margin:0 0 8px;font-family:"Kanit",sans-serif;font-weight:400;font-size:16px}
  .country h4 img{border-radius:3px;box-shadow:0 0 0 1px rgba(255,255,255,.2)}
  .country h4 span{margin-left:auto;font-family:"Radio Canada",sans-serif;font-size:12.5px;color:var(--faint)}
  .region{border-top:1px solid rgba(255,255,255,.08)}
  .region summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none;padding:9px 0;font-family:"Kanit",sans-serif;font-weight:300;font-size:15px;color:var(--ink)}
  .region summary::-webkit-details-marker{display:none}
  .region summary::before{content:"";width:7px;height:7px;border-right:1.5px solid var(--faint);border-bottom:1.5px solid var(--faint);transform:rotate(-45deg);transition:transform .2s;margin:0 4px 0 2px}
  .region[open] summary::before{transform:rotate(45deg)}
  .region summary em{margin-left:auto;font-style:normal;font-family:"Radio Canada",sans-serif;font-size:12.5px;color:var(--faint)}
  .country ul{list-style:none;margin:0;padding:0 0 10px 18px;display:flex;flex-wrap:wrap;gap:4px 12px;font-size:15px;color:var(--soft)}
  .country li.lived{color:var(--ink)}
  .country li.lived::after{content:" ●";font-size:9px;color:#b79cff;vertical-align:2px}

  @media (max-width:640px){.panel{padding:20px}.map{height:300px}}
</style>
